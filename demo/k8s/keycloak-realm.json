{
  "realm": "nuna",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "loginWithEmailAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "privateKey": "${NUNA_REALM_PRIVATE_KEY}",
  "certificate": "${NUNA_REALM_CERTIFICATE}",
  "roles": {
    "client": {
      "cloudbeaver": [{"name": "admin", "description": "CloudBeaver's team admin: its administrator"}],
      "silo": [{"name": "diagnostics", "description": "Silo's built-in policy diagnostics: the server's health, metrics, logs and traces, and no bucket or object"},
               {"name": "warehouse-read", "description": "Silo policy warehouse-read (silo-warehouse-read.json): lists the buckets and reads the warehouse bucket's objects, writes nothing"},
               {"name": "consoleAdmin", "description": "Silo's built-in policy consoleAdmin: every bucket and object, and the server's administration"}]
    }
  },
  "groups": [
    {"name": "demo-analysts"},
    {"name": "demo-grant-admins"},
    {"name": "demo-stewards"},
    {"name": "demo-operators", "clientRoles": {
      "cloudbeaver": ["admin"],
      "silo": ["diagnostics"],
      "realm-management": ["view-realm", "view-users", "view-clients", "view-events", "view-identity-providers",
                           "view-authorization"]
    }},
    {"name": "demo-auditors"},
    {"name": "demo-audit-writers"},
    {"name": "demo-maintenance"},
    {"name": "demo-presenters"}
  ],
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "firstName": "Ana",
      "lastName": "Analyst",
      "email": "ana@nuna.demo",
      "emailVerified": true,
      "realmRoles": ["default-roles-nuna"],
      "credentials": [{"type": "password", "value": "${NUNA_PASSWORD_ANA}", "temporary": false}],
      "clientRoles": {"silo": ["warehouse-read"]},
      "groups": ["/demo-analysts"]
    },
    {
      "username": "gary",
      "enabled": true,
      "firstName": "Gary",
      "lastName": "Grants",
      "email": "gary@nuna.demo",
      "emailVerified": true,
      "realmRoles": ["default-roles-nuna"],
      "credentials": [{"type": "password", "value": "${NUNA_PASSWORD_GARY}", "temporary": false}],
      "groups": ["/demo-grant-admins", "/demo-auditors"]
    },
    {
      "username": "stella",
      "enabled": true,
      "firstName": "Stella",
      "lastName": "Steward",
      "email": "stella@nuna.demo",
      "emailVerified": true,
      "realmRoles": ["default-roles-nuna"],
      "credentials": [{"type": "password", "value": "${NUNA_PASSWORD_STELLA}", "temporary": false}],
      "groups": ["/demo-stewards"]
    },
    {
      "username": "oscar",
      "enabled": true,
      "firstName": "Oscar",
      "lastName": "Operator",
      "email": "oscar@nuna.demo",
      "emailVerified": true,
      "realmRoles": ["default-roles-nuna"],
      "credentials": [{"type": "password", "value": "${NUNA_PASSWORD_OSCAR}", "temporary": false}],
      "groups": ["/demo-operators"]
    },
    {
      "username": "presenter",
      "enabled": true,
      "firstName": "Demo",
      "lastName": "Presenter",
      "email": "presenter@nuna.demo",
      "emailVerified": true,
      "realmRoles": ["default-roles-nuna"],
      "credentials": [{"type": "password", "value": "${NUNA_PASSWORD_PRESENTER}", "temporary": false}],
      "clientRoles": {"silo": ["warehouse-read", "consoleAdmin"], "realm-management": ["realm-admin"]},
      "groups": ["/demo-analysts", "/demo-grant-admins", "/demo-stewards", "/demo-operators", "/demo-auditors",
                 "/demo-presenters"]
    },
    {
      "username": "service-account-nuna-audit-tables",
      "enabled": true,
      "serviceAccountClientId": "nuna-audit-tables",
      "groups": ["/demo-audit-writers"]
    },
    {
      "username": "service-account-nuna-maintenance",
      "enabled": true,
      "serviceAccountClientId": "nuna-maintenance",
      "groups": ["/demo-maintenance"]
    }
  ],
  "clients": [
    {
      "clientId": "nuna-console",
      "name": "Nuna console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["https://${DEMO_HOST}:8181/ui/*"],
      "webOrigins": ["https://${DEMO_HOST}:8181"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${DEMO_HOST}:8181/ui/*"
      },
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "nuna-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "nuna-catalog"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "claim.name": "groups",
            "full.path": "false"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "nuna-audit-tables",
      "name": "Audit table writer",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NUNA_AUDIT_TABLES_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "nuna-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "nuna-catalog"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "claim.name": "groups",
            "full.path": "false"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "nuna-maintenance",
      "name": "Maintenance worker",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NUNA_MAINTENANCE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "nuna-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "nuna-catalog"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "claim.name": "groups",
            "full.path": "false"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "kafbat",
      "name": "kafbat (Kafka UI)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["https://${DEMO_HOST}:8182/login/oauth2/code/keycloak"],
      "webOrigins": ["https://${DEMO_HOST}:8182"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups",
            "full.path": "false"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "grafana",
      "name": "Grafana (metrics and traces)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["https://${DEMO_HOST}:8188/login/generic_oauth"],
      "webOrigins": ["https://${DEMO_HOST}:8188"],
      "attributes": {"pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${DEMO_HOST}:8188/login"},
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups",
            "full.path": "false"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "cloudbeaver",
      "name": "CloudBeaver",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NUNA_CLOUDBEAVER_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["https://${DEMO_HOST}:8185/oauth2/callback"],
      "webOrigins": ["https://${DEMO_HOST}:8185"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${DEMO_HOST}:8185/*"
      },
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "cloudbeaver-teams",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "cloudbeaver",
            "multivalued": "true",
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "cloudbeaver_teams",
            "jsonType.label": "String"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "singlestore-studio",
      "name": "SingleStore Studio",
      "protocol": "saml",
      "enabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": ["https://${DEMO_HOST}:8183/api/saml-assert"],
      "attributes": {
        "saml.client.signature": "false",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml.encrypt": "false",
        "saml.authnstatement": "true",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "username",
        "saml_assertion_consumer_url_post": "https://${DEMO_HOST}:8183/api/saml-assert"
      }
    },
    {
      "clientId": "silo",
      "name": "Silo's console",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NUNA_SILO_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["https://${DEMO_HOST}:8184/oauth_callback"],
      "webOrigins": ["https://${DEMO_HOST}:8184"],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "silo-policy",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "silo",
            "multivalued": "true",
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "policy",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
