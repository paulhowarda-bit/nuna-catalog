{
  "connector.class": "org.apache.iceberg.connect.IcebergSinkConnector",
  "tasks.max": "1",
  "topics": "oracle.TREASURY.BANK_PAYMENTS,oracle.TREASURY.GL_JOURNAL,oracle.TREASURY.GL_BALANCES",
  "transforms": "lowercasekey,debezium,lowercase",
  "transforms.lowercasekey.type": "org.apache.kafka.connect.transforms.ReplaceField$Key",
  "transforms.lowercasekey.renames": "PAYMENT_ID:payment_id,JOURNAL_ID:journal_id,BALANCE_ID:balance_id",
  "transforms.debezium.type": "org.apache.iceberg.connect.transforms.DebeziumTransform",
  "transforms.lowercase.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.lowercase.renames": "PAYMENT_ID:payment_id,VERSION:version,BROKERAGE_ACCOUNT:brokerage_account,RAIL:rail,DIRECTION:direction,STATUS:status,AMOUNT:amount,FIRM_BANK_ACCOUNT:firm_bank_account,COUNTERPARTY_ROUTING_NUMBER:counterparty_routing_number,COUNTERPARTY_ACCOUNT_NUMBER:counterparty_account_number,COUNTERPARTY_NAME:counterparty_name,VALUE_DATE:value_date,EVENT_TIME:event_time,UPDATED_AT:updated_at,JOURNAL_ID:journal_id,BUSINESS_DATE:business_date,GL_ACCOUNT:gl_account,GL_ACCOUNT_NAME:gl_account_name,DEFINITION_ID:definition_id,DEBIT_TOTAL:debit_total,CREDIT_TOTAL:credit_total,LINE_COUNT:line_count,POSTED_AT:posted_at,BALANCE_ID:balance_id,NORMAL_SIDE:normal_side,BALANCE:balance",
  "iceberg.tables": "history.oracle.treasury.bank_payments,history.oracle.treasury.gl_journal,history.oracle.treasury.gl_balances",
  "iceberg.tables.route-field": "_cdc.source",
  "iceberg.table.history.oracle.treasury.bank_payments.route-regex": ".*[.]BANK_PAYMENTS",
  "iceberg.table.history.oracle.treasury.gl_journal.route-regex": ".*[.]GL_JOURNAL",
  "iceberg.table.history.oracle.treasury.gl_balances.route-regex": ".*[.]GL_BALANCES",
  "iceberg.tables.auto-create-enabled": "true",
  "iceberg.tables.evolve-schema-enabled": "true",
  "iceberg.control.topic": "oracle-history-control",
  "iceberg.control.commit.interval-ms": "5000",
  "iceberg.catalog.type": "rest",
  "iceberg.catalog.uri": "http://nuna-catalog:8181",
  "iceberg.catalog.warehouse": "lakehouse",
  "iceberg.catalog.token": "${env:NUNA_TOKEN}",
  "iceberg.catalog.header.X-Iceberg-Access-Delegation": "vended-credentials",
  "iceberg.catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO"
}
