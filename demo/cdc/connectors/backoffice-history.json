{
  "connector.class": "org.apache.iceberg.connect.IcebergSinkConnector",
  "tasks.max": "1",
  "topics": "backoffice.party.parties,backoffice.party.accounts,backoffice.party.account_roles,backoffice.party.cip_checks,backoffice.party.suitability_profiles,backoffice.party.beneficial_owners,backoffice.party.trusted_contacts,backoffice.money_movement.payments,backoffice.money_movement.ach_returns,backoffice.money_movement.acats_transfers,backoffice.compliance.aml_alerts,backoffice.compliance.aml_cases,backoffice.compliance.complaints",
