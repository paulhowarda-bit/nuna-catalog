  "iceberg.tables": "history.postgres.party.parties,history.postgres.party.accounts,history.postgres.party.account_roles,history.postgres.party.cip_checks,history.postgres.party.suitability_profiles,history.postgres.party.beneficial_owners,history.postgres.party.trusted_contacts,history.postgres.money_movement.payments,history.postgres.money_movement.ach_returns,history.postgres.money_movement.acats_transfers,history.postgres.compliance.aml_alerts,history.postgres.compliance.aml_cases,history.postgres.compliance.complaints",
  "iceberg.tables.route-field": "_cdc.source",
  "iceberg.table.history.postgres.party.parties.route-regex": ".*[.]parties",
  "iceberg.table.history.postgres.party.accounts.route-regex": ".*[.]accounts",
  "iceberg.table.history.postgres.party.account_roles.route-regex": ".*[.]account_roles",
  "iceberg.table.history.postgres.party.cip_checks.route-regex": ".*[.]cip_checks",
  "iceberg.table.history.postgres.party.suitability_profiles.route-regex": ".*[.]suitability_profiles",
  "iceberg.table.history.postgres.party.beneficial_owners.route-regex": ".*[.]beneficial_owners",
  "iceberg.table.history.postgres.party.trusted_contacts.route-regex": ".*[.]trusted_contacts",
  "iceberg.table.history.postgres.money_movement.payments.route-regex": ".*[.]payments",
  "iceberg.table.history.postgres.money_movement.ach_returns.route-regex": ".*[.]ach_returns",
  "iceberg.table.history.postgres.money_movement.acats_transfers.route-regex": ".*[.]acats_transfers",
  "iceberg.table.history.postgres.compliance.aml_alerts.route-regex": ".*[.]aml_alerts",
  "iceberg.table.history.postgres.compliance.aml_cases.route-regex": ".*[.]aml_cases",
  "iceberg.table.history.postgres.compliance.complaints.route-regex": ".*[.]complaints",
  "iceberg.tables.auto-create-enabled": "true",
  "iceberg.tables.evolve-schema-enabled": "true",
  "iceberg.control.topic": "backoffice-history-control",
  "iceberg.control.commit.interval-ms": "5000",
  "iceberg.catalog.type": "rest",
  "iceberg.catalog.uri": "http://nuna-catalog:8181",
  "iceberg.catalog.warehouse": "lakehouse",
  "iceberg.catalog.token": "${env:NUNA_TOKEN}",
