{
  "connector.class": "io.debezium.connector.cockroachdb.CockroachDBConnector",
  "tasks.max": "1",
  "database.hostname": "cockroach",
  "database.port": "26257",
  "database.user": "debezium",
  "database.password": "${env:CDC_DEBEZIUM_PASSWORD}",
  "database.dbname": "custody",
  "database.sslmode": "disable",
  "topic.prefix": "cockroach",
  "schema.include.list": "clearing",
  "table.include.list": "clearing.stock_record,clearing.cns_obligations,clearing.fails,clearing.locates",
  "cockroachdb.changefeed.sink.type": "sinkless",
  "cockroachdb.changefeed.include.diff": "true",
  "tombstones.on.delete": "false"
}
