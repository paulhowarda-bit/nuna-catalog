Breaks: a register with overwrite onto a held name is answered as if overwrite were false.
Module: catalog-server
Test: RestRoutesTest#registerBringsADroppedTableBackAndRefusesTakenUuidsAndLocationsOutsideTheProfile

diff --git a/catalog-server/src/main/java/nuna/catalog/server/rest/TableRoutes.java b/catalog-server/src/main/java/nuna/catalog/server/rest/TableRoutes.java
index 77a5cbe..da8e68f 100644
--- a/catalog-server/src/main/java/nuna/catalog/server/rest/TableRoutes.java
+++ b/catalog-server/src/main/java/nuna/catalog/server/rest/TableRoutes.java
@@ -240,7 +240,7 @@ class TableRoutes {
         RestRequest.Registration registration = RestRequest.register(json);
         NamespaceRecord record = lookup.existingNamespace(catalog, levels);
         guard.onNamespace(request, catalog, record, levels, Guard.REGISTER_TABLE, Http.noSuchNamespace(levels));
-        if (registration.overwrite() && lookup.object(record, registration.name(), Kind.TABLE).isPresent()) {
+        if (false && lookup.object(record, registration.name(), Kind.TABLE).isPresent()) {
             throw CatalogError.badRequest("Registering over an existing table (overwrite) is not supported: "
                     + Http.qualified(levels, registration.name()) + ". Commit to the table, or drop or unregister it"
                     + " first; a register would skip the commit rules and the table's journal");
