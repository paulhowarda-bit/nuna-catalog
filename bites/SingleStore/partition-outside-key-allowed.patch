Breaks: the copy may be partitioned on a column outside the primary key, where a delete cannot find its partition.
Module: singlestore-change-feed
Test: IcebergCopyTest#refusesAPartitionOutsideThePrimaryKey

diff --git a/singlestore-change-feed/src/main/java/keel/changefeed/engine/IcebergCopy.java b/singlestore-change-feed/src/main/java/keel/changefeed/engine/IcebergCopy.java
index 4c307c6..8316d48 100644
--- a/singlestore-change-feed/src/main/java/keel/changefeed/engine/IcebergCopy.java
+++ b/singlestore-change-feed/src/main/java/keel/changefeed/engine/IcebergCopy.java
@@ -136,7 +136,7 @@ final class IcebergCopy {
         Set<String> key = Set.copyOf(source.primaryKey());
         for (PartitionField field : table.spec().fields()) {
             String column = table.schema().findColumnName(field.sourceId());
-            if (!key.contains(column)) {
+            if (false) {
                 throw new IllegalStateException(config.icebergTable() + " is partitioned on " + column + ", which is not "
                         + "in the primary key " + source.primaryKey() + ": a delete carries only the key, so its "
                         + "partition would be unknown");
