Breaks: a drop the store finds under a legal hold is answered 403 but not audited, so the audit trail loses what was refused.
Module: catalog-server
Test: GovernanceRefusalTest#aDropUnderALegalHoldIsAuditedAsADenial

diff --git a/catalog-server/src/main/java/nuna/catalog/server/rest/ObjectRoutes.java b/catalog-server/src/main/java/nuna/catalog/server/rest/ObjectRoutes.java
index c8843f0..a23f708 100644
--- a/catalog-server/src/main/java/nuna/catalog/server/rest/ObjectRoutes.java
+++ b/catalog-server/src/main/java/nuna/catalog/server/rest/ObjectRoutes.java
@@ -154,8 +154,7 @@ class ObjectRoutes {
                 case WriteResult.Applied applied -> new Reply(204, "", true);
                 case WriteResult.Missing missing -> throw noSuch(kind, qualified);
                 case WriteResult.Refused refused when refused.reason() == WriteResult.Reason.HELD ->
-                        throw guard.refuse(request, catalog, object, AuditEvents.path(levels, name),
-                                kind == Kind.TABLE ? Guard.DROP_TABLE : Guard.DROP_VIEW, "legal_hold",
+                        throw new AccessDenied(
                                 word(kind) + " " + qualified + " is under a legal hold and cannot be dropped");
                 default -> throw new IllegalStateException("dropObject answered " + result);
             };
