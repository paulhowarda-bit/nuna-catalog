Module: catalog-maintenance
Test: WorkerMetricsTest#aScanAddsEachCountAndEachFailureByItsKind
diff --git a/catalog-maintenance/src/main/java/keel/maintenance/WorkerMetrics.java b/catalog-maintenance/src/main/java/keel/maintenance/WorkerMetrics.java
index 816a4c1..28770ea 100644
--- a/catalog-maintenance/src/main/java/keel/maintenance/WorkerMetrics.java
+++ b/catalog-maintenance/src/main/java/keel/maintenance/WorkerMetrics.java
@@ -134,7 +134,7 @@ final class WorkerMetrics {
             scan.run();
             ended = true;
         } finally {
-            boolean success = ended && !report.failuresByKind.containsKey(ScanReport.Failure.WORK_LIST);
+            boolean success = ended && report.failures.isEmpty();
             counts.forEach((count, counter) -> counter.increment(count.of().applyAsInt(report)));
             report.failuresByKind.forEach((kind, times) -> failures.get(kind).increment(times));
             report.needs.forEach((reason, tables) -> needing.get(reason).increment(tables));
