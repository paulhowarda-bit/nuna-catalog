--- a/catalog-maintenance/src/main/java/nuna/maintenance/Worker.java
+++ b/catalog-maintenance/src/main/java/nuna/maintenance/Worker.java
@@ -388,7 +388,7 @@ final class Worker implements AutoCloseable {
             spans.part(ScanSpans.Part.PURGE, KeyValues.empty(), () -> purged(purge, report), outcome -> outcome);
         } catch (RuntimeException e) {
             LOG.warn("Failed purging {} ({})", purge.name(), purge.id(), e);
-            report.failed(ScanReport.Failure.PURGE, "purging " + purge.id(), e);
+            report.failed(ScanReport.Failure.DELETION, "purging " + purge.id(), e);
         }
     }
 
