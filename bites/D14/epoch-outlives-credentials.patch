         long index = Math.floorDiv(clock.millis(), window.toMillis());
         Instant ends = Instant.ofEpochMilli(Math.multiplyExact(index + 1, window.toMillis()));
-        if (credentials.expiresAt().isBefore(ends.plus(refreshMargin))) {
