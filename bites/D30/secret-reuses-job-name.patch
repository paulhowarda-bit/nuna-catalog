Module: catalog-maintenance
Test: KubernetesJobsTest#oneJobPerTableSignedInThroughASecretItOwns
diff --git a/catalog-maintenance/src/main/java/keel/maintenance/KubernetesJobs.java b/catalog-maintenance/src/main/java/keel/maintenance/KubernetesJobs.java
