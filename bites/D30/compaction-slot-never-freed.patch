+++ b/catalog-maintenance/src/main/java/nuna/maintenance/Slots.java
@@ -30,10 +30,7 @@ final class Slots {
 
     /** Takes the lowest free slot for a Job of the table; the caller has seen one {@link #free}. */
     int take(UUID table) {
-        int slot = 1;
-        while (taken.containsKey(slot)) {
-            slot++;
-        }
