Module: catalog-maintenance
Test: NightJobsTest#eachJobTakesTheLowestFreeSlotAndCountsItsOwnReplaces
diff --git a/catalog-maintenance/src/main/java/nuna/maintenance/Slots.java b/catalog-maintenance/src/main/java/nuna/maintenance/Slots.java
