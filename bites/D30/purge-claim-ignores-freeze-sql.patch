Breaks: a purge claim reads no DR freeze, so a frozen object is claimed and its files deleted.
Module: catalog-store-sql
Test: PostgresStoreSuiteTest$CatalogObjects#purgeIsClaimedThenCompleted
diff --git a/catalog-store-sql/src/main/java/keel/catalog/store/sql/SqlObjects.java b/catalog-store-sql/src/main/java/keel/catalog/store/sql/SqlObjects.java
index e8d4f31..95638c7 100644
--- a/catalog-store-sql/src/main/java/keel/catalog/store/sql/SqlObjects.java
+++ b/catalog-store-sql/src/main/java/keel/catalog/store/sql/SqlObjects.java
@@ -236,9 +236,6 @@ final class SqlObjects {
             if (Guards.held(connection, objectId, claim.catalogId(), claim.path())) {
                 return new WriteResult.Refused(WriteResult.Reason.HELD);
             }
-            if (Guards.frozen(connection, objectId, claim.catalogId(), claim.path())) {
-                return new WriteResult.Refused(WriteResult.Reason.FROZEN);
-            }
             update(connection, "UPDATE catalog_object SET state = 'PURGING', purge_claimant = ? WHERE id = ?",
                     claimant, objectId);
             return WriteResult.APPLIED;
