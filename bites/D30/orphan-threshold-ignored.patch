Module: catalog-maintenance
Test: OrphanScanTest#youngOrphansAreKept
diff --git a/catalog-maintenance/src/main/java/keel/maintenance/OrphanScan.java b/catalog-maintenance/src/main/java/keel/maintenance/OrphanScan.java
index 947db92..3910936 100644
--- a/catalog-maintenance/src/main/java/keel/maintenance/OrphanScan.java
+++ b/catalog-maintenance/src/main/java/keel/maintenance/OrphanScan.java
@@ -58,7 +58,7 @@ final class OrphanScan {
         List<String> candidates = new ArrayList<>();
         long cut = cutoff.toEpochMilli();
         for (FileInfo file : storage.list(root)) {
-            if (file.createdAtMillis() < cut && !reach.files.contains(Storage.normalize(file.location()))) {
