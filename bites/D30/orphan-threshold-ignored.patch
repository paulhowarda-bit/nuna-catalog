Module: catalog-maintenance
Test: OrphanScanTest#youngOrphansAreKept
diff --git a/catalog-maintenance/src/main/java/nuna/maintenance/OrphanScan.java b/catalog-maintenance/src/main/java/nuna/maintenance/OrphanScan.java
index 4b58879..348ae52 100644
--- a/catalog-maintenance/src/main/java/nuna/maintenance/OrphanScan.java
+++ b/catalog-maintenance/src/main/java/nuna/maintenance/OrphanScan.java
@@ -76,7 +76,7 @@ final class OrphanScan {
             if (!open.getAsBoolean()) {
                 throw new CutShort(root);
             }
-            if (file.createdAtMillis() < cut && !reach.files.contains(Storage.normalize(file.location()))) {
+            if (!reach.files.contains(Storage.normalize(file.location()))) {
                 candidates.add(file.location());
             }
         }
