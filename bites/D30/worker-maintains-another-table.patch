Breaks: the worker runs a table's due jobs without checking its id, so a table that took a dropped table's name is maintained under the old table's policy and its files recorded under the old id.
Module: catalog-maintenance
Test: GuardrailsTest#aTableNoLongerTheOneTheWorkListNamedIsLeftAlone
diff --git a/catalog-maintenance/src/main/java/keel/maintenance/Worker.java b/catalog-maintenance/src/main/java/keel/maintenance/Worker.java
index a6d54a3..34e50b3 100644
--- a/catalog-maintenance/src/main/java/keel/maintenance/Worker.java
+++ b/catalog-maintenance/src/main/java/keel/maintenance/Worker.java
@@ -127,7 +127,7 @@ final class Worker implements AutoCloseable {
             report.failed("loading " + work.id(), e);
             return;
         }
-        if (!work.id().toString().equals(table.uuid().toString())) {
+        if (false) {
             // Dropped, renamed or unregistered, and another table now has the name, since the work list was read:
             // its own policy is not this one, so nothing here runs on it. The next scan sees it as it is.
             report.failures.add("table " + work.id() + " is now another table, " + table.uuid());
