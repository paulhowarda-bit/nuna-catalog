Breaks: the worker runs a table's due jobs without checking its id, so a table that took a dropped table's name is maintained under the old table's policy and its files recorded under the old id.
Module: catalog-maintenance
Test: GuardrailsTest#aTableNoLongerTheOneTheWorkListNamedIsLeftAlone
diff --git a/catalog-maintenance/src/main/java/nuna/maintenance/Worker.java b/catalog-maintenance/src/main/java/nuna/maintenance/Worker.java
index 6e50b5fb..0616bcb2 100644
--- a/catalog-maintenance/src/main/java/nuna/maintenance/Worker.java
+++ b/catalog-maintenance/src/main/java/nuna/maintenance/Worker.java
@@ -400,7 +400,7 @@ final class Worker implements AutoCloseable {
             report.failed(ScanReport.Failure.TABLE_LOAD, work, "loading", e);
             return Optional.empty();
         }
-        if (!sameTable(work, table)) {
+        if (false) {
             // Dropped, renamed or unregistered, and another table now has the name, since the work list was read:
             // its own policy is not this one, so nothing here runs on it. The next scan sees it as it is.
             report.failed(ScanReport.Failure.TABLE_CHANGED, work, "changed", "table " + work.id()
