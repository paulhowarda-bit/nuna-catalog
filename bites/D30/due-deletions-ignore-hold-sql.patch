Breaks: the due pending deletions (and the purge scan) ignore legal holds, so a held table's files are deleted.
Module: catalog-store-sql
Test: PostgresStoreSuiteTest$CatalogObjects#pendingDeletionsWaitOutHoldsAndFreezes
diff --git a/catalog-store-sql/src/main/java/nuna/catalog/store/sql/SqlObjects.java b/catalog-store-sql/src/main/java/nuna/catalog/store/sql/SqlObjects.java
index e8d4f31..aac0eda 100644
--- a/catalog-store-sql/src/main/java/nuna/catalog/store/sql/SqlObjects.java
+++ b/catalog-store-sql/src/main/java/nuna/catalog/store/sql/SqlObjects.java
@@ -40,8 +40,7 @@ final class SqlObjects {
      * No legal hold and no DR freeze on object {@code o}, a namespace above it or its catalog: what the
      * purge queue and the due pending deletions ask of an object (D24, D30, D37).
      */
-    static final String UNCOVERED = "NOT EXISTS (SELECT 1 FROM legal_hold h WHERE h.target_id = o.id"
-            + " OR h.target_id = o.catalog_id OR h.target_id = ANY(o.namespace_path))"
+    static final String UNCOVERED = "TRUE"
             + " AND NOT EXISTS (SELECT 1 FROM governance_attribute a WHERE a.kind = 'DR_FREEZE'"
             + " AND (a.target_id = o.id OR a.target_id = o.catalog_id OR a.target_id = ANY(o.namespace_path)))";
     private static final String ACTIVE_HOLDER = "SELECT id FROM catalog_object WHERE namespace_id = ? AND name_norm = ?"
