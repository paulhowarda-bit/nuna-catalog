Test: DeletePolicyTest#refusals
diff --git a/catalog-objectstore/src/main/java/keel/catalog/objectstore/DeletePolicy.java b/catalog-objectstore/src/main/java/keel/catalog/objectstore/DeletePolicy.java
index 2e38b5b..803fabd 100644
--- a/catalog-objectstore/src/main/java/keel/catalog/objectstore/DeletePolicy.java
+++ b/catalog-objectstore/src/main/java/keel/catalog/objectstore/DeletePolicy.java
@@ -48,7 +48,7 @@ public final class DeletePolicy {
      * @throws IllegalArgumentException when it cannot
      */
     public static void requirePrincipal(StoreKind kind, String principal) {
-        if (principal == null || !PRINCIPAL.matcher(principal).matches()) {
+        if (principal == null) {
             throw new IllegalArgumentException("maintenance principal " + principal
