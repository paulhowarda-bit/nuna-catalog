Breaks: the worker runs expiry and the orphan scan whenever the policy names them, even when the catalog has switched them off for a legal hold.
Module: catalog-maintenance
Test: GuardrailsTest#heldFrozenAndUnregisteredTablesAreUntouched
diff --git a/catalog-maintenance/src/main/java/nuna/maintenance/Worker.java b/catalog-maintenance/src/main/java/nuna/maintenance/Worker.java
index 6e5d46d..7d69fe7 100644
--- a/catalog-maintenance/src/main/java/nuna/maintenance/Worker.java
+++ b/catalog-maintenance/src/main/java/nuna/maintenance/Worker.java
@@ -156,10 +156,10 @@ final class Worker implements AutoCloseable {
      */
     void maintain(Management.TableWork work, Instant now, ScanReport report) {
         report.tables++;
-        boolean expire = work.runs("snapshot-expiry.enabled");
+        boolean expire = work.policy().containsKey("snapshot-expiry.enabled");
         boolean rewrite = work.runs("manifest-rewrite.enabled");
         Optional<CleanupWindow.Night> open = open();
-        boolean orphans = open.isPresent() && work.runs("orphan-removal.enabled")
+        boolean orphans = open.isPresent() && work.policy().containsKey("orphan-removal.enabled")
                 && orphanScanDue(work.id(), open.get());
         boolean assess = open.isPresent() && work.runs("compaction.enabled") && compactor != Compactor.NONE
                 && !tonight.assessed(work.id());
