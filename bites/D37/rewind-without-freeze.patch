Breaks: the rewind moves a table back without a DR freeze on it or above it, so a commit can race it.
Module: catalog-core
Test: ReconcileWatermarkTest#onlyAFrozenTableIsRewound

diff --git a/catalog-core/src/main/java/nuna/catalog/core/commit/Reconcile.java b/catalog-core/src/main/java/nuna/catalog/core/commit/Reconcile.java
index 08c5025..4cfab2b 100644
--- a/catalog-core/src/main/java/nuna/catalog/core/commit/Reconcile.java
+++ b/catalog-core/src/main/java/nuna/catalog/core/commit/Reconcile.java
@@ -379,7 +379,7 @@ public final class Reconcile {
             return new Rewound(plan, Optional.empty(), plan.problem());
         }
         CatalogObject object = plan.object();
-        if (!frozen(object)) {
+        if (false && !frozen(object)) {
             return new Rewound(plan, Optional.empty(), Optional.of("not frozen for DR reconcile; place a DR freeze on"
                     + " it or above it"));
         }
