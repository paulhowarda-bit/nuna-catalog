Breaks: cached credentials are reused inside the refresh margin, so loads keep handing out credentials that expire too soon.
Module: catalog-server
Test: VendingNearExpiryTest
diff --git a/catalog-server/src/main/java/nuna/catalog/server/storage/StsCredentialVending.java b/catalog-server/src/main/java/nuna/catalog/server/storage/StsCredentialVending.java
index 47cf27c..9ddb0d5 100644
--- a/catalog-server/src/main/java/nuna/catalog/server/storage/StsCredentialVending.java
+++ b/catalog-server/src/main/java/nuna/catalog/server/storage/StsCredentialVending.java
@@ -82,7 +82,7 @@ public final class StsCredentialVending implements CredentialVending {
         this.clock = clock;
         this.window = settings.credentialLifetime().dividedBy(4);
         this.refreshMargin = refreshMargin;
-        this.cache = new CredentialCache(window.plus(refreshMargin).plusMinutes(1),
+        this.cache = new CredentialCache(window,
                 settings.credentialCacheEntries(), clock);
     }
 
