Breaks: Audit's Most recorded no longer wraps its paths, so its Records and Reads columns run out of the card at 1440 px (backlog 220).
Module: catalog-server
Test: ConsoleBrowserTest#auditFiltersByKindKeepsItsFiltersInTheLinkAndHidesItsOwnReads

diff --git a/catalog-server/src/main/resources/nuna/ui/audit.js b/catalog-server/src/main/resources/nuna/ui/audit.js
index d8a0986c..faeea168 100644
--- a/catalog-server/src/main/resources/nuna/ui/audit.js
+++ b/catalog-server/src/main/resources/nuna/ui/audit.js
@@ -187,7 +187,7 @@ function objectLink(catalog, kind, path, tab) {
   const target = k === 'namespace' ? {catalog, kind: k, namespace: levels}
     : {catalog, kind: k, namespace: levels.slice(0, -1), name: levels[levels.length - 1]};
   // The path breaks after each dot, so a long one wraps and the number columns beside it stay in view (backlog 220).
-  return h('a', {href: objectHref(target, tab)}, levels.flatMap((x, i) => i < levels.length - 1 ? [x + '.', h('wbr')] : [x]));
+  return h('a', {href: objectHref(target, tab)}, levels.join('.'));
 }
 
