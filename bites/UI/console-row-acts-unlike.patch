Breaks: Row actions keep their own looks: plain text beside a bordered Merge.
Module: catalog-server
Test: ConsoleBrowserTest#rowActionsLookAlikeWithDeleteLastAndSetApart

diff --git a/catalog-server/src/main/resources/nuna/ui/style.css b/catalog-server/src/main/resources/nuna/ui/style.css
--- a/catalog-server/src/main/resources/nuna/ui/style.css
+++ b/catalog-server/src/main/resources/nuna/ui/style.css
@@ -1458,7 +1458,7 @@
 
 /* Row actions look alike (the 27 Nov review; backlog 331): every one a ghost button with a quiet outline, the same on
    Branches and tags as on Governance, and delete last, set apart and in the bad ink. */
-.row-acts .btn, .row-acts .btn.ghost { border-color: var(--line); background: transparent; color: var(--text-2); }
+.row-acts .btn.no-such-thing { border-color: var(--line); background: transparent; color: var(--text-2); }
 .row-acts .btn:hover { background: var(--surface-2); border-color: var(--line-strong); color: var(--text); }
 .row-acts .btn.danger { margin-left: 10px; color: var(--bad-ink, var(--warn-ink)); }
 .row-acts .btn.danger:hover { background: var(--bad-wash); border-color: var(--bad-ink); }
