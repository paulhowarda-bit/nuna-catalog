   } else if (s.kind === 'int') {
     const [min, max] = rangeOf(s, ctx);
-    if (!/^\d+$/.test(typed) || Number(typed) < min || Number(typed) > max) {
+    if (!/^\d+$/.test(typed)) {
       return {error: `A whole number from ${fmt(min)} to ${fmt(max)}.`};
     }
     value = String(Number(typed));
