Breaks: On a phone, the note that a page shows main only stays on one line in the header, which runs past the window.
Module: catalog-server
Test: ConsoleBrowserTest#onAPhoneABranchCarriedOntoAPageThatShowsMainOnlyKeepsTheHeaderInTheWindow

diff --git a/catalog-server/src/main/resources/nuna/ui/style.css b/catalog-server/src/main/resources/nuna/ui/style.css
index d42cc6c8..f693d901 100644
--- a/catalog-server/src/main/resources/nuna/ui/style.css
+++ b/catalog-server/src/main/resources/nuna/ui/style.css
@@ -1342,7 +1342,6 @@ details.tech[open] > summary { margin-bottom: 4px; }
   .nc-top .reading-slot .ref-wrap { position: static; }
   .nc-top .reading-slot .ref-menu { left: 12px; right: auto; width: min(380px, calc(100% - 24px)); min-width: 0; }
   .nc-pick b, .nc-top .ref-pick .cref .nm { min-width: 0; max-width: 12ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
-  .reading-slot .main-only { position: absolute; top: calc(100% + 1px); left: 0; right: 0; height: 28px; display: flex; align-items: center; margin: 0; padding: 0 14px; background: var(--surface-2); border-bottom: 1px solid var(--line); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
   .nc-app:has(.reading-slot .main-only) .slot > .nc-main { padding-top: 44px; }
 }
 @container frame (max-width: 520px) { .nc-brand { display: none; } }
