Breaks: Sign-out sends no ID token, so the IdP asks the person to confirm on its own page.
Module: catalog-server
Test: ConsoleSignInTest#signOutEndsTheIdpSessionSoTheNextSignInAsksForThePassword

diff --git a/catalog-server/src/main/resources/nuna/ui/auth.js b/catalog-server/src/main/resources/nuna/ui/auth.js
index f1bf7b05..7b377cb9 100644
--- a/catalog-server/src/main/resources/nuna/ui/auth.js
+++ b/catalog-server/src/main/resources/nuna/ui/auth.js
@@ -161,7 +161,6 @@ export function endSessionUrl(meta, oidc, idToken) {
   if (!meta.end_session_endpoint) return null;
   const url = new URL(meta.end_session_endpoint);
   url.searchParams.set('client_id', oidc['client-id']);
-  if (idToken) url.searchParams.set('id_token_hint', idToken);
   url.searchParams.set('post_logout_redirect_uri', redirectUri(oidc));
   return url.toString();
 }
