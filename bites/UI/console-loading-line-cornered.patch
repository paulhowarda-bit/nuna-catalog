Breaks: The loading line sits in the page's corner, outside its padding.
Module: catalog-server
Test: ConsoleBrowserTest#signInDrawsNoRailItemBeforeTheCatalogListAnswers

diff --git a/catalog-server/src/main/resources/nuna/ui/style.css b/catalog-server/src/main/resources/nuna/ui/style.css
--- a/catalog-server/src/main/resources/nuna/ui/style.css
+++ b/catalog-server/src/main/resources/nuna/ui/style.css
@@ -1070,7 +1070,7 @@
 .loading-line { color: var(--text-2); font-size: var(--t-13); }
 /* A page's loading line, and the one before sign-in answers, sit where the page will, inside its padding, not in the
    corner (the 27 Nov review; backlog 331). */
-#booting, .slot > .loading-line { padding: 24px 28px 32px; }
+#booting, .slot > .loading-line { padding: 0; }
 @media (max-width: 760px) { #booting, .slot > .loading-line { padding: 16px 14px 24px; } }
 .tab-body { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
 .waiting { color: var(--text-2); }
