Module: catalog-store-oracle
Test: OracleStoreSuiteTest$Refs#aDeletionLeavesNothing

diff --git a/catalog-store-oracle/src/main/java/nuna/catalog/store/oracle/OracleRefs.java b/catalog-store-oracle/src/main/java/nuna/catalog/store/oracle/OracleRefs.java
