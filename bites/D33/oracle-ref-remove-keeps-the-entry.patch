Breaks: taking a table out of refs on Oracle deletes the branch's own pointer but not the ref's entry, so the tag still names the table and its purge stays refused (backlog 156).
Module: catalog-store-oracle
Test: OracleStoreSuiteTest$Refs#takingATableOutOfRefs

diff --git a/catalog-store-oracle/src/main/java/nuna/catalog/store/oracle/OracleRefs.java b/catalog-store-oracle/src/main/java/nuna/catalog/store/oracle/OracleRefs.java
index 608ffa63..325e0106 100644
--- a/catalog-store-oracle/src/main/java/nuna/catalog/store/oracle/OracleRefs.java
+++ b/catalog-store-oracle/src/main/java/nuna/catalog/store/oracle/OracleRefs.java
@@ -264,7 +264,6 @@ final class OracleRefs {
             String branchIn = Jdbc.in("branch", ids.stream().map(UUID::toString).toList(), own);
             update(connection, "DELETE FROM pointer WHERE object_id = ? AND " + branchIn, own.toArray());
             update(connection, "DELETE FROM projection_piece WHERE object_id = ? AND " + branchIn, own.toArray());
-            update(connection, "DELETE FROM ref_entry WHERE object_id = ? AND " + refIn, named.toArray());
             return WriteResult.APPLIED;
         });
     }
