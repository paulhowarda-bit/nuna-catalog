Breaks: a ref made from a branch on the SQL stores takes the branch's cut even where the branch has its own pointer (D33).
Module: catalog-store-sql
Test: PostgresStoreSuiteTest$Refs#aRefFromABranchTakesItsOwnPointers

diff --git a/catalog-store-sql/src/main/java/nuna/catalog/store/sql/SqlRefs.java b/catalog-store-sql/src/main/java/nuna/catalog/store/sql/SqlRefs.java
index b6bfa28..ca85b4f 100644
--- a/catalog-store-sql/src/main/java/nuna/catalog/store/sql/SqlRefs.java
+++ b/catalog-store-sql/src/main/java/nuna/catalog/store/sql/SqlRefs.java
@@ -53,7 +53,7 @@ final class SqlRefs {
             + " SELECT CAST(? AS UUID), e.object_id, e.kind, e.parent_id, e.name_norm, e.name,"
             + " COALESCE(p.version, e.version), COALESCE(p.metadata_location, e.metadata_location),"
             + " COALESCE(p.sha256, e.sha256) FROM ref_entry e"
-            + " LEFT JOIN pointer p ON p.object_id = e.object_id AND p.branch = ? WHERE e.ref_id = ?";
+            + " LEFT JOIN pointer p ON p.object_id = e.object_id AND p.branch = ? AND 1 = 0 WHERE e.ref_id = ?";
     /** The objects of a ref's cut, which are the only objects a ref's own pointers can name (D33, question 1). */
     private static final String CUT_OBJECTS = "SELECT object_id FROM ref_entry WHERE ref_id = ?";
 
