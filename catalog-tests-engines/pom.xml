<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fidice</groupId>
    <artifactId>fidice-catalog-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>catalog-tests-engines</artifactId>
  <description>Nightly engine matrix: Spark, Flink, Trino, PyIceberg, DuckDB and SingleStore against the catalog, in docker compose.</description>

  <dependencies>
    <!-- The run's S3 store: -Ds3=silo (default), ceph or aws. -->
    <dependency>
      <groupId>fidice</groupId>
      <artifactId>catalog-tests-s3</artifactId>
    </dependency>
    <dependency>
      <!-- Not on the test classpath for its classes: it orders the reactor so the exec jar the compose
           stack runs is built first. -->
      <groupId>fidice</groupId>
      <artifactId>catalog-server</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>fidice</groupId>
      <artifactId>catalog-security</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <engines.compose>${project.basedir}/compose/compose.yaml</engines.compose>
            <engines.catalog-jar>${project.basedir}/../catalog-server/target/catalog-server-${project.version}-exec.jar</engines.catalog-jar>
            <engines.run-dir>${project.build.directory}/engines-run</engines.run-dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
