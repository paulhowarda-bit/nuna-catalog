    {
      "id": 15,
      "type": "timeseries",
      "title": "Files recorded, deleted and left outside, an hour",
      "description": "Recorded: handed to the catalog's pending-deletion list. Deleted: due deletions and purged objects' files. Outside: unreferenced files outside their table's location, never deleted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(nuna_maintenance_files_recorded_total{job=~\"$job\"}[1h]))",
          "legendFormat": "recorded",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(nuna_maintenance_files_deleted_total{job=~\"$job\"}[1h]))",
          "legendFormat": "deleted",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(nuna_maintenance_files_outside_total{job=~\"$job\"}[1h]))",
          "legendFormat": "outside",
          "refId": "C",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
