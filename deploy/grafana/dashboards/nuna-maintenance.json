    {
      "id": 13,
      "type": "timeseries",
      "title": "Expiry and manifest rewrites an hour",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
