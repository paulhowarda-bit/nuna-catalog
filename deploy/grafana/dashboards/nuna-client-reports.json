        "label": "Engine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values({__name__=~\"nuna_catalog_report_.+_count\", job=~\"$job\"}, engine_name)",
        "query": "label_values({__name__=~\"nuna_catalog_report_.+_count\", job=~\"$job\"}, engine_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
