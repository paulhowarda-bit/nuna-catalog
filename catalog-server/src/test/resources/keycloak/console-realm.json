{
  "realm": "console",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "loginWithEmailAllowed": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "groups": [
    {
      "name": "console-users"
    }
  ],
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "firstName": "Ana",
      "lastName": "Analyst",
      "email": "ana@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${NUNA_TEST_PASSWORD}",
          "temporary": false
        }
      ],
      "groups": [
        "/console-users"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "nuna-console",
      "name": "Nuna console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://host.testcontainers.internal:8181/ui/"
      ],
      "webOrigins": [
        "http://host.testcontainers.internal:8181"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://host.testcontainers.internal:8181/ui/"
      },
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "nuna-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "nuna-catalog"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "claim.name": "groups",
            "full.path": "false"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
