<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fidice</groupId>
    <artifactId>fidice-catalog-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>catalog-tests-conformance</artifactId>
  <description>Runs the Iceberg REST Compatibility Kit against the server, with a no-regression ratchet.</description>

  <properties>
    <!-- The RCK 1.12.0 is built on JUnit 5.14.4 (platform 1.14.4); Boot 4.1.2 manages JUnit 6. -->
    <junit-jupiter.version>5.14.4</junit-jupiter.version>
    <hadoop.version>3.4.3</hadoop.version>
    <!-- The reference RESTCatalogServer runs on Jetty 12.1 (ee10) over SQLite; Boot manages neither ee10 nor
         the compression modules, so the Jetty version Boot manages is named here. -->
    <fixture-jetty.version>${jetty.version}</fixture-jetty.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>fidice</groupId>
      <artifactId>catalog-server</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>fidice</groupId>
      <artifactId>catalog-security</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-open-api</artifactId>
      <version>${iceberg.version}</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-open-api</artifactId>
      <version>${iceberg.version}</version>
      <classifier>test-fixtures</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-core</artifactId>
      <version>${iceberg.version}</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-api</artifactId>
      <version>${iceberg.version}</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The RCK client writes manifests and data files itself, to Silo, through S3FileIO. -->
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-aws</artifactId>
      <version>${iceberg.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>apache-client</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- iceberg-aws declares no SDK dependencies; its client factory loads these classes. -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>kms</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- iceberg-aws declares no SDK dependencies; its client factory loads these classes. -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sts</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- iceberg-aws declares no SDK dependencies; its client factory loads these classes. -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>glue</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- iceberg-aws declares no SDK dependencies; its client factory loads these classes. -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.ee10</groupId>
      <artifactId>jetty-ee10-servlet</artifactId>
      <version>${fixture-jetty.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.compression</groupId>
      <artifactId>jetty-compression-server</artifactId>
      <version>${fixture-jetty.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.compression</groupId>
      <artifactId>jetty-compression-gzip</artifactId>
      <version>${fixture-jetty.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The RCK client calls new org.apache.hadoop.conf.Configuration(). -->
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <version>${hadoop.version}</version>
      <scope>test</scope>
      <exclusions>
        <!-- A second SLF4J backend would fight Spring Boot's Logback. -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-reload4j</artifactId>
        </exclusion>
        <exclusion>
          <groupId>ch.qos.reload4j</groupId>
          <artifactId>reload4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- hadoop-common's dependency tree does not converge; it is test-only here. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>dependency-convergence</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Only our harness runs here; it launches the RCK classes itself. -->
          <includes>
            <include>fidice/**/*Test.java</include>
          </includes>
          <systemPropertyVariables>
            <postgres.image>${postgres.image}</postgres.image>
            <silo.image>${silo.image}</silo.image>
            <kafka.image>${kafka.image}</kafka.image>
            <rck.reasons>${project.basedir}/rck-reasons.txt</rck.reasons>
            <rck.baseline>${project.basedir}/rck-baseline.txt</rck.baseline>
            <rck.results>${project.build.directory}/rck-results.txt</rck.results>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
