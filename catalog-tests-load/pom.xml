<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fidice</groupId>
    <artifactId>fidice-catalog-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>catalog-tests-load</artifactId>
  <description>M8 hardening gates: load, contention, resilience and SLO runs against running servers. Every test is heavy.</description>

  <properties>
    <!-- The release before this one, for the rolling upgrade: main as M7 landed it. Its servers migrate
         only the shared steps (V1 to V3); this release adds PostgreSQL's V4. -->
    <fidice.previous-release>75df4ff</fidice.previous-release>
  </properties>

  <dependencies>
    <dependency>
      <!-- Only so the reactor builds the server first; the tests run its runnable jar. -->
      <groupId>fidice</groupId>
      <artifactId>catalog-server</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>fidice</groupId>
      <artifactId>catalog-security</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The server under test runs as its own process, from the exec jar the reactor just built. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>server-jar</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>fidice</groupId>
                  <artifactId>catalog-server</artifactId>
                  <version>${project.version}</version>
                  <classifier>exec</classifier>
                  <destFileName>catalog-server.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/m8</outputDirectory>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <postgres.image>${postgres.image}</postgres.image>
            <silo.image>${silo.image}</silo.image>
            <kafka.image>${kafka.image}</kafka.image>
            <m8.server-jar>${project.build.directory}/m8/catalog-server.jar</m8.server-jar>
            <m8.work>${project.build.directory}/m8</m8.work>
            <m8.repo-root>${project.basedir}/..</m8.repo-root>
            <m8.previous-release>${fidice.previous-release}</m8.previous-release>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
