<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fidice</groupId>
    <artifactId>fidice-catalog-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>catalog-objectstore</artifactId>
  <description>Storage profiles, metadata.json I/O, credential vending.</description>

  <properties>
    <!-- Two S3 implementations, neither of them AWS's: Ceph RGW (F7) and Silo, the maintained
         MinIO fork (F5, 5.14), whose image the parent POM pins. -->
    <ceph.image>ghcr.io/clyso/ceph-test:v20.2.5</ceph.image>
  </properties>

  <dependencies>
    <dependency>
      <groupId>fidice</groupId>
      <artifactId>catalog-core</artifactId>
    </dependency>
    <!-- The synchronous client only; its default HTTP client is apache5-client. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <ceph.image>${ceph.image}</ceph.image>
            <silo.image>${silo.image}</silo.image>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
