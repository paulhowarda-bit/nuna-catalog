<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fidice</groupId>
    <artifactId>fidice-catalog-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>catalog-store-oracle</artifactId>
  <description>Oracle backend, including Exadata/RAC.</description>

  <properties>
    <!-- 23.26.4.0.0 is the first ojdbc17 certified for JDK 25; Boot 4.1.2 manages 23.26.3.0.0
         (research_notes/Build plan facts/java_platform.md). -->
    <oracle-database.version>23.26.4.0.0</oracle-database.version>
    <!-- Oracle AI Database Free 23.26.3, slim (fewer components) and faststart (pre-created database). -->
    <oracle.image>gvenzl/oracle-free:23.26.3-slim-faststart</oracle.image>
  </properties>

  <dependencies>
    <dependency>
      <groupId>fidice</groupId>
      <artifactId>catalog-store-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc17</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-oracle</artifactId>
    </dependency>

    <dependency>
      <groupId>fidice</groupId>
      <artifactId>catalog-store-api</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A pool in the tests: a frozen log writer also blocks new logons, so stores must borrow
         connections that already exist. -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ucp17</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-oracle-free</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-toxiproxy</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <oracle.image>${oracle.image}</oracle.image>
            <toxiproxy.image>${toxiproxy.image}</toxiproxy.image>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Nightly, the overnight run (root pom): the CAS test, at 1,000 rounds. No build runs it. -->
    <profile>
      <id>nightly</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <fidice.suite.cas-rounds>1000</fidice.suite.cas-rounds>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
